<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectGuid>{DB2765AE-526C-45FB-AF50-056F05570822}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>WackysSecondaryAttacks</RootNamespace>
    <AssemblyName>WackysSecondaryAttacks</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>12</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <GameReferences Condition="'$(GameReferences)' == ''">$(MSBuildThisFileDirectory)..\bin\$(Configuration)</GameReferences>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\Debug\</OutputPath>
    <Optimize>false</Optimize>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="0Harmony">
      <HintPath>$(GameReferences)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameReferences)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(GameReferences)\assembly_valheim_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameReferences)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameReferences)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\WackysRecipeCustomization.csproj">
      <Project>{4358610B-F3F4-4843-B7AF-98B7BC60DCDE}</Project>
      <Name>WackysRecipeCustomization</Name>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="WackyDBSecondaryAttacks.cs" />
    <None Include="README.md" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="PackageSecondaryAttacks" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ThunderstoreDir>$(MSBuildThisFileDirectory)..\ThunderstoreSecondaryAttacks</ThunderstoreDir>
    </PropertyGroup>
    <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
      <Output TaskParameter="Assemblies" ItemName="SecondaryAssemblyIdentity" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <SecondaryAssemblyVersion>%(SecondaryAssemblyIdentity.Version)</SecondaryAssemblyVersion>
      <SecondaryPackageVersion>$([System.Version]::Parse('$(SecondaryAssemblyVersion)').ToString(3))</SecondaryPackageVersion>
    </PropertyGroup>
    <MakeDir Directories="$(ThunderstoreDir)\plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ThunderstoreDir)\plugins" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)README.md" DestinationFolder="$(ThunderstoreDir)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\Thunderstore\icon.png" DestinationFolder="$(ThunderstoreDir)" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; { $ErrorActionPreference = 'Stop'; $package = '$(ThunderstoreDir)'; $manifestPath = Join-Path $package 'manifest.json'; $manifest = Get-Content -LiteralPath $manifestPath -Raw | ConvertFrom-Json; if ($manifest.name -ne 'WackyDBSecondaryAttacks') { throw 'Unexpected secondary package name.' }; if ($manifest.version_number -ne '$(SecondaryPackageVersion)') { $manifest.version_number = '$(SecondaryPackageVersion)'; $manifest | ConvertTo-Json -Depth 4 | Set-Content -LiteralPath $manifestPath -Encoding UTF8 }; $files = @('manifest.json', 'README.md', 'CHANGELOG.md', 'icon.png', 'plugins') | ForEach-Object { Join-Path $package $_ }; Compress-Archive -LiteralPath $files -DestinationPath (Join-Path $package 'WackyDBSecondaryAttacks-$(SecondaryPackageVersion).zip') -Force }&quot;" />
  </Target>
  <Target Name="CopySecondaryAttacksToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="C:\Program Files (x86)\Steam\steamapps\common\Valheim\BepInEx\plugins" />
  </Target>
</Project>